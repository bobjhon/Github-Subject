        function filterBikes(category) {
            document.querySelectorAll('.filter-btn').forEach(btn => {
                btn.classList.remove('bg-neonCyan', 'text-black');
                btn.classList.add('text-gray-400');
            });
            event.target.classList.add('bg-neonCyan', 'text-black');
            event.target.classList.remove('text-gray-400');
            renderBikeCards(category);
        }

        /* Hero Switcher */
        function changeHeroBike(index) {
            const preset = heroBikePresets[index];
            const img = document.getElementById('heroBikeImg');
            img.style.opacity = '0';
            setTimeout(() => {
                document.getElementById('heroBikeTitle').innerText = preset.title;
                document.getElementById('heroBikePrice').innerText = preset.price;
                img.src = preset.img;
                img.style.opacity = '1';
            }, 200);
        }

        function setCustomColor(colorKey, finishName, glowHex, imgUrl) {
            document.getElementById('finishBadge').innerText = finishName;
            document.getElementById('customizerImg').src = imgUrl;
            
            const glow = document.getElementById('customizerGlow');
            glow.style.backgroundColor = glowHex;

            // Highlight color button
            document.querySelectorAll('.color-btn').forEach(btn => {
                btn.classList.remove('border-neonCyan');
                btn.classList.add('border-transparent');
            });
            event.currentTarget.classList.add('border-neonCyan');
            event.currentTarget.classList.remove('border-transparent');
        }

        function toggleOption(checkbox, price) {
            if(checkbox.checked) {
                selectedOptionsPrice += price;
            } else {
                selectedOptionsPrice -= price;
            }
            updateCustomPrice();
        }

        function updateCustomPrice() {
            const total = baseCustomPrice + selectedOptionsPrice;
            document.getElementById('customPrice').innerText = `$${total.toLocaleString()}`;
        }

        function toggleMobileNav() {
            const nav = document.getElementById('mobileNav');
            nav.classList.toggle('hidden');
        }

        document.getElementById('mobileMenuBtn').addEventListener('click', toggleMobileNav);

        function openTestRideModal() {
            const modal = document.getElementById('testRideModal');
            modal.classList.remove('opacity-0', 'pointer-events-none');
            modal.querySelector('div').classList.remove('scale-95');
            modal.querySelector('div').classList.add('scale-100');
        }

        function closeTestRideModal() {
            const modal = document.getElementById('testRideModal');
            modal.classList.add('opacity-0', 'pointer-events-none');
            modal.querySelector('div').classList.remove('scale-100');
            modal.querySelector('div').classList.add('scale-95');
            
            // Reset form status
            setTimeout(() => {
                document.getElementById('testRideForm').classList.remove('hidden');
                document.getElementById('modalSuccess').classList.add('hidden');
            }, 300);
        }

        function selectBikeForRide(bikeName) {
            document.getElementById('modalBikeSelect').value = bikeName;
            openTestRideModal();
        }

        function submitTestRide(e) {
            e.preventDefault();
            document.getElementById('testRideForm').classList.add('hidden');
            document.getElementById('modalSuccess').classList.remove('hidden');
        }

        function openCustomConfigModal() {
            selectBikeForRide('Velocity Apex-X Custom');
        }

        function toggleSearchModal() {
            const modal = document.getElementById('searchModal');
            modal.classList.toggle('opacity-0');
            modal.classList.toggle('pointer-events-none');
            if(!modal.classList.contains('opacity-0')) {
                document.getElementById('searchInput').focus();
            }
        }

        function handleSearch(query) {
            const results = document.getElementById('searchResults');
            if(!query.trim()) {
                results.innerHTML = `<p class="text-xs font-rajdhani text-gray-500 uppercase">Suggested Searches: Superbike, Electric, 200HP, Customizer</p>`;
                return;
            }

            const matched = bikesData.filter(b => 
                b.name.toLowerCase().includes(query.toLowerCase()) || 
                b.category.toLowerCase().includes(query.toLowerCase())
            );

            if(matched.length === 0) {
                results.innerHTML = `<p class="text-sm text-gray-400">No superbikes matched "${query}"</p>`;
            } else {
                results.innerHTML = matched.map(b => `
                    <div onclick="selectBikeForRide('${b.name}'); toggleSearchModal();" class="p-3 rounded-xl bg-obsidian border border-gray-800 hover:border-neonCyan cursor-pointer flex items-center justify-between">
                        <div>
                            <p class="font-orbitron font-bold text-sm text-white">${b.name}</p>
                            <p class="text-xs text-neonCyan font-rajdhani">${b.hp} - $${b.price.toLocaleString()}</p>
                        </div>
                        <i class="fa-solid fa-chevron-right text-gray-500 text-xs"></i>
                    </div>
                `).join('');
            }
        }

        function handleNewsletter(e) {
            e.preventDefault();
            alert('Thank you for subscribing to VELOCITY updates!');
            e.target.reset();
        }

        // Initialize component view on window load
        window.onload = function() {
            renderBikeCards();
        }
    </script>
</body>
</html>
